@model NationalParkWebApp.Models.NationalPark

@{
    var title = Model.Id != 0 ? "Edit National Park" : "Create National Park";
    var saveUpdate = Model.Id != 0 ? "Update" : "Create";
}

<form method="post" enctype="multipart/form-data">

    @if (Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row border p-2 m-2">
        <div class="col-12 border-bottom">
            <h2 class="text-primary">@title</h2>
        </div>

        <div class="col-8">
            <div class="form-group row p-2 m-2">
                <div class="col-4">
                    <label asp-for="Name"></label>
                </div>
                <div class="col-8">
                    <input type="text" class="form-control" asp-for="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="col-8">
            <div class="form-group row p-2 m-2">
                <div class="col-4">
                    <label asp-for="State"></label>
                </div>
                <div class="col-8">
                    <input type="text" class="form-control" asp-for="State" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="col-8">
            <div class="form-group row p-2 m-2">
                <div class="col-4">
                    <label>Picture</label>
                </div>
                <div class="col-8">
                    <input type="file" name="files" id="imageId" class="form-control" />
                </div>
            </div>
            <div class=" form-group row p-2 m-2">
                    @{
                        var dataEst = " ";
                        if(Model.Id!=0)
                        {
                            dataEst = Model.Established.ToShortDateString();
                        }
                    }
            </div>
        </div>

        <div class="col-8">
            <div class="form-group row p-2 m-2">
                <div class="col-4">
                    <label asp-for="Established"></label>
                </div>
                <div class="col-8">
                    <input type="text" class="form-control" id="datePicker"
                           asp-for="Established" value="@dataEst" />                    <span asp-validation-for="Established" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="col-8">
            <div class="form-group row p-2 m-2">
                <div class="col-4 offset-4">
                    <button type="submit" class="btn btn-primary form-control">@saveUpdate</button>
                </div>
                <div class="col-4">
                    <a asp-action="Index" class="btn btn-success form-control"> 
                        Back to List 
                        </a>
                </div>
            </div>
        </div>
        <div class=" col-4">
            <p> Image Display </p>
            <div class=" col-4">
                @if(Model.Picture !=null)
                {
                        var base64 = Convert.ToBase64String(Model.Picture);
                    var imgSrc = String.Format("data:image/jpg;base64,{0}", base64);
                    @* <img src="@imgSrc" width="100%" /> *@
                    <img src="@imgSrc" style="width:300px; height:auto;" />
                        }
            </div>
        </div>
    </div>

</form>
@section Scripts 
{
	<script>
		$(function () {
			$("#datePicker").datepicker({
				changeMonth: true,
				changeYear: true,
			});
		});
	</script>
}